# Copy to .env for local development. Never commit real values.
# Meta Model API key. Locally the app also reads it from ~/.config/delegate/model_api_key.
MODEL_API_KEY=
# Meta Model API base URL.
META_API_BASE=https://api.meta.ai/v1
# Negotiation model and voice-note model.
DELEGATE_MODEL=muse-spark-1.3
DELEGATE_AUDIO_MODEL=muse-spark-1.2
# PostgreSQL URL. Empty means start an embedded pgserver under .pgdata/.
DATABASE_URL=
# Provider mode: live | mock. Mock is labelled MOCK_ONLY everywhere in the UI and evidence.
DELEGATE_PROVIDER_MODE=live
# Public demo quotas.
DELEGATE_SESSIONS_PER_IP_PER_HOUR=6
DELEGATE_PROVIDER_CONCURRENCY=4
